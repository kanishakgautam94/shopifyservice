# Copy to .env.local for local dev, and add these in Vercel → Settings → Environment Variables.

# Resend — contact form email delivery (https://resend.com)
# Required in production. Without these, the form fails closed and asks visitors to email you.
RESEND_API_KEY=

# Where contact form submissions are sent (defaults to info@shopifyservice.com)
CONTACT_TO_EMAIL=info@shopifyservice.com

# Verified Resend sender. Required. Until you verify your domain, you can use:
# "Shopify Service <onboarding@resend.dev>"
CONTACT_FROM_EMAIL="Shopify Service <onboarding@resend.dev>"

# Your live Calendly booking URL, e.g. https://calendly.com/your-handle/consultation
# If unset, the contact page shows email/phone instead of the widget.
NEXT_PUBLIC_CALENDLY_URL=

# Google Analytics 4 measurement ID (for ad conversion tracking), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Meta (Facebook / Instagram) Pixel ID for ad tracking, e.g. 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=
